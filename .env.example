# Copy to .env. Never commit real secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PG_HOST=localhost
PG_PORT=5434
PG_DBNAME=postgres
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres
# Run python scripts/configure_runtime.py after schema setup to generate this password.
PG_READONLY_USER=echo_runtime
PG_READONLY_PASSWORD=set_by_configure_runtime
NEO4J_URI=bolt://localhost:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Provisional threshold; final evaluation will calibrate it (lower is stricter).
RETRIEVAL_MAX_DISTANCE=0.60
