# Copy to .env. Never commit real secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PG_HOST=localhost
PG_PORT=5434
PG_DBNAME=postgres
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres
# Docker-only setup: choose your own password below. Python setup can generate it instead.
PG_READONLY_USER=echo_runtime
PG_READONLY_PASSWORD=set_by_configure_runtime
NEO4J_URI=bolt://localhost:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Provisional threshold; final evaluation will calibrate it (lower is stricter).
RETRIEVAL_MAX_DISTANCE=0.60

# Docker-only setup: choose your own staff password below. Python setup can generate it instead.
STAFF_USERNAME=staff
STAFF_PASSWORD=set_by_configure_runtime
